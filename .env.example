# ============================================================================
# .env.example — Panduan Konfigurasi Environment Variables
# Salin file ini menjadi .env jika ingin mengubah pengaturan secara lokal/online
# ============================================================================

# Port Server Lokal (Default: 3000)
PORT=3000

# Pengaturan Host yang Diizinkan (Pisahkan dengan koma jika lebih dari satu)
# Nilai default sudah mengizinkan: localhost, 127.0.0.1, *.vercel.app, *.trycloudflare.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app,*.trycloudflare.com

# URL Database PostgreSQL / Neon / Supabase (Opsional - Fallback Serverless)
# Jika dikosongkan, aplikasi akan menggunakan SQLite / Storage Serverless bawaan
# DATABASE_URL=postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Path Database SQLite Lokal / Serverless (Default Vercel: /tmp/db.sqlite3)
# SQLITE_PATH=/tmp/db.sqlite3

# Mode Pengujian / Akses Jam Login Bebas (0 = Jam Standar 05:30-08:00, 1 = Bebas 24 Jam)
# SBL_MODE_UJI=0
